# Runtime state — the Docker bind mount (db, workspace, backups)
data/

# Deploy tool local state.
#
# settings.json holds the SSH password (encrypted with Windows DPAPI, but
# still a credential) alongside paths that are specific to one machine.
# It was tracked at one point, so it also needs untracking once:
#     git rm --cached tools/settings.json
#
# The .done note is a record of the last deploy and means nothing to anyone
# else; next_deploy.txt IS committed on purpose, so the prepared message
# travels with the change it describes.
tools/settings.json
tools/next_deploy.done.txt

# The worker node's own config — holds the server URL and its bearer TOKEN.
# Never commit it: the token is the node's whole authentication to the
# machine API, and the repo is the one place it must not appear.
# worker_service/config.example.json is the template that IS tracked.
worker_service/config.json

# Spreadsheet lock files, created by LibreOffice when a sheet is open.
.~lock.*#

# The catalogue is DATA, not application code. It lives one folder up, it
# is 21 MB, and a second copy inside the repo is a second record of the
# same fact that nobody updates. Import it through the admin screen
# rather than shipping it inside the image.
/travel_titled.csv
/CHECK_catalogue.csv
