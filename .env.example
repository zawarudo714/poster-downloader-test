# Copy to .env on the server and fill in. Compose reads .env automatically.
#
#   cp .env.example .env
#   nano .env
#
# Generate each value with:  openssl rand -hex 32

# Signs session cookies. If this changes, everyone is logged out.
SESSION_SECRET=

# Encrypts marketplace account passwords (app/pipeline.py).
# TREAT THIS AS PERMANENT. If it changes, stored account passwords can no
# longer be decrypted — the accounts pause with a clear reason rather than
# crashing, but you must re-enter every password by hand.
PIPELINE_SECRET=

# Timezone. Affects displayed timestamps and the day boundary used by
# payments and the marketplace daily upload quota.
TZ=Africa/Nairobi
APP_TZ=Africa/Nairobi
